# Copy this file to .env and fill in every value. Never commit .env.
# Each line is NAME=value. No quotes, no spaces around the equals sign.

# Shared secret that parmana-core sends in the Authorization header.
# At least 32 characters. Generate one with the command in docs/SETUP.md.
PARMANA_SERVICE_BEARER_TOKEN=

# Parmana's Ed25519 public key, PEM. Use the key from the Parmana operator.
PARMANA_PUBLIC_KEY_FILE=keys\parmana-public.pem

# The connector manifest (JSON or YAML) that names the capabilities this service runs.
PARMANA_CONNECTOR_MANIFEST=manifests\httpbin.json

# Any existing folder. The crypto bootstrap requires it.
PARMANA_POLICY_DIR=policies

# memory for local tests, postgres for a shared deployment.
PARMANA_NONCE_STORE=memory

# Required only when PARMANA_NONCE_STORE=postgres.
# PARMANA_DATABASE_URL=

# Optional. Default 8080.
# PARMANA_SERVICE_PORT=8080

# Optional. Default 10000 (ms).
# PARMANA_CONNECTOR_TIMEOUT_MS=10000

# Host to bind. Default 127.0.0.1. Set 0.0.0.0 on a hosted deployment such as Render.
# PARMANA_SERVICE_HOST=127.0.0.1

# The endpoint URL registered in parmana-core, exactly as registered. Signed
# releases from parmana-core are refused unless their audience equals this value.
# Unset, signed releases are refused with 503.
PARMANA_RELEASE_AUDIENCE=

# The upstream secret. Its name must match the secretRef in your manifest.
# This example manifest uses HTTPBIN_TOKEN. Use a test value only.
HTTPBIN_TOKEN=
