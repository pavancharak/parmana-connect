# Copy this file to .env and fill in every value. Never commit .env.
# Each line is NAME=value. No quotes, no spaces around the equals sign.

# Shared secret that parmana-core sends in the Authorization header.
# At least 32 characters. Generate one with the command in docs/SETUP.md.
PARMANA_SERVICE_BEARER_TOKEN=

# Parmana's Ed25519 public key, PEM. Use the key from the Parmana operator.
PARMANA_PUBLIC_KEY_FILE=keys\parmana-public.pem

# The connector manifest (JSON or YAML) that names the capabilities this service runs.
PARMANA_CONNECTOR_MANIFEST=manifests\httpbin.json

# Any existing folder. The crypto bootstrap requires it.
PARMANA_POLICY_DIR=policies

# memory for local tests, postgres for a shared deployment.
PARMANA_NONCE_STORE=memory

# Required only when PARMANA_NONCE_STORE=postgres.
# PARMANA_DATABASE_URL=

# Optional. Default 8080.
# PARMANA_SERVICE_PORT=8080

# Optional. Default 10000 (ms).
# PARMANA_CONNECTOR_TIMEOUT_MS=10000

# Host to bind. Default 127.0.0.1. Set 0.0.0.0 on a hosted deployment such as Render.
# PARMANA_SERVICE_HOST=127.0.0.1

# The endpoint URL registered in parmana-core, exactly as registered. Signed
# releases from parmana-core are refused unless their audience equals this value.
# Unset, signed releases are refused with 503.
PARMANA_RELEASE_AUDIENCE=

# Optional pins. When set, the service refuses to start unless the values match exactly.
# Run `npm run doctor` to check the whole configuration before starting.
# The fingerprint is the sha256: value you confirmed through a second channel.
# PARMANA_EXPECTED_KEY_FINGERPRINT=sha256:
# The audience must equal the URL registered in parmana-core, character for character.
# PARMANA_EXPECTED_AUDIENCE=

# The upstream secret. Its name must match the secretRef in your manifest.
# This example manifest uses HTTPBIN_TOKEN. Use a test value only.
HTTPBIN_TOKEN=

# Release-only mode is the default and should stay on. The bearer-token route
# is closed unless PARMANA_RELEASE_ONLY is set to false explicitly.
# PARMANA_RELEASE_ONLY=true

# Development only: allows a Parmana key that is not pinned. Never on a hosted deployment.
# PARMANA_ALLOW_UNPINNED_KEY=

# Optional. The key id that parmana-core publishes. Default "default". Used by npm run doctor.
# PARMANA_CORE_KEY_ID=default

# Optional. parmana-core's base URL. Used by npm run doctor to compare the key and the clock.
# PARMANA_CORE_URL=

# MCP server (npm run mcp:http, or npm run mcp). It exposes each capability as an
# AI tool, and every tool call goes to Parmana's API first. Optional.
# PARMANA_API_URL=
# PARMANA_API_KEY=
# PARMANA_MCP_BEARER_TOKEN=     at least 32 characters
# PARMANA_MCP_HOST=127.0.0.1    default
# PARMANA_MCP_PORT=8081         default
# PARMANA_AUTHORITY_TYPE=
# PARMANA_AUTHORITY_ID=
# PARMANA_PRINCIPAL_ID=
# PARMANA_AUTHORIZATION_ID=
# PARMANA_AUTHORIZATION_PURPOSE=
# PARMANA_SOURCE_SYSTEM=        default parmana-connect
# PARMANA_SUBMITTED_BY=         default: PARMANA_PRINCIPAL_ID

# Used only by scripts/signed-request.mjs, a local helper. Default http://localhost:8080.
# PARMANA_SERVICE_URL=

# Tests only. The service does not read these.
# PARMANA_TEST_DATABASE_URL=
# PARMANA_TEST_ACTION=
# PARMANA_TEST_TARGET=
